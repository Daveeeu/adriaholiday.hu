# Written by deploy/production/bootstrap.sh; Traefik reloads it on change.
# The site answers on PUBLIC_HOST: the staging host until the domain switch,
# then adriaholiday.hu, with www and the staging host redirecting there
# permanently. The names start with "adriaholiday-hu" so they never clash with
# another file in the directory.
http:
  routers:
    adriaholiday-hu:
      rule: "Host(`__PUBLIC_HOST__`)"
      entryPoints:
        - __ENTRYPOINT__
      service: adriaholiday-hu
      tls:
        certResolver: __CERT_RESOLVER__
    # redirect:start
    adriaholiday-hu-redirect:
      rule: "Host(`www.adriaholiday.hu`) || Host(`adriaholiday.jandldavid.hu`)"
      entryPoints:
        - __ENTRYPOINT__
      middlewares:
        - adriaholiday-hu-canonical-host
      service: adriaholiday-hu
      tls:
        certResolver: __CERT_RESOLVER__
    # redirect:end
  middlewares:
    adriaholiday-hu-canonical-host:
      redirectRegex:
        regex: "^https?://[^/]+(.*)"
        replacement: "https://__PUBLIC_HOST__${1}"
        permanent: true
  services:
    adriaholiday-hu:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://adriaholiday-nginx-1:80"
