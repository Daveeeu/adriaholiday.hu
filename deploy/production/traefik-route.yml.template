# Written by deploy/production/bootstrap.sh; Traefik reloads it on change.
# The site answers on adriaholiday.hu only: www and the former staging host
# (adriaholiday.jandldavid.hu) redirect there permanently. The names start with
# "adriaholiday-hu" so they never clash with another file in the directory.
http:
  routers:
    adriaholiday-hu:
      rule: "Host(`adriaholiday.hu`)"
      entryPoints:
        - __ENTRYPOINT__
      service: adriaholiday-hu
      tls:
        certResolver: __CERT_RESOLVER__
    adriaholiday-hu-redirect:
      rule: "Host(`www.adriaholiday.hu`) || Host(`adriaholiday.jandldavid.hu`)"
      entryPoints:
        - __ENTRYPOINT__
      middlewares:
        - adriaholiday-hu-canonical-host
      service: adriaholiday-hu
      tls:
        certResolver: __CERT_RESOLVER__
  middlewares:
    adriaholiday-hu-canonical-host:
      redirectRegex:
        regex: "^https?://[^/]+(.*)"
        replacement: "https://adriaholiday.hu${1}"
        permanent: true
  services:
    adriaholiday-hu:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://adriaholiday-nginx-1:80"
