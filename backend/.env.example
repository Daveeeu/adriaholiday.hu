APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BOOKING_OFFICE_EMAIL=

# Barion online payment. Leave BARION_POS_KEY empty to disable online payment.
# BARION_ENVIRONMENT: test (sandbox) or prod
BARION_ENVIRONMENT=test
BARION_POS_KEY=
BARION_PAYEE_EMAIL=
BARION_REDIRECT_URL=

# Mailchimp: newsletter subscribers are synced into this audience.
# Leave MAILCHIMP_API_KEY empty to disable. The key ends in the data center (e.g. -us21).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DOUBLE_OPT_IN=false
MAILCHIMP_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ANALYTICS_ENABLED=true
ANALYTICS_DEBUG=false
ANALYTICS_QUEUE=analytics
ANALYTICS_SESSION_COOKIE=ah_session_id
ANALYTICS_SESSION_LIFETIME=30
META_PIXEL_ID=
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_CAPI_API_VERSION=v20.0
META_CAPI_TIMEOUT=5
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# AI travel sales assistant demo on Retell AI (config/sales_assistant.php,
# docs/ai-sales-assistant.md). Off by default. The Retell API key stays on the
# server: it creates the web calls and verifies Retell's function calls.
SALES_ASSISTANT_ENABLED=false
# The browser demo page (/ai-utazasi-tanacsado); the agent's functions work without it.
SALES_ASSISTANT_DEMO_PAGE_ENABLED=false
# Optional: when set, a conversation can only be started with this code.
SALES_ASSISTANT_ACCESS_CODE=
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_LLM_MODEL=gpt-4.1
RETELL_VOICE_ID=
SALES_ASSISTANT_SESSION_TTL=600
SALES_ASSISTANT_DAILY_SESSION_LIMIT=100
SALES_ASSISTANT_SESSIONS_PER_IP_PER_HOUR=6
